{
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/static/lightweight-charts.js", "destination": "https://unpkg.com/lightweight-charts@4.1.3/dist/lightweight-charts.standalone.production.js" },
    { "source": "/layers", "destination": "/index.html" }
  ],
  "headers": [{ "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }, { "key": "Referrer-Policy", "value": "no-referrer" }] }]
}
